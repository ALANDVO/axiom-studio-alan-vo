# Application runtime configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEMO_MODE=true
DATABASE_URL=sqlite:///./axiom_studio.sqlite3

# Keycloak OIDC Authentication with SAML Brokering
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=axiom-realm
KEYCLOAK_CLIENT_ID=axiom-studio
KEYCLOAK_CLIENT_SECRET=

# Advisory LLM Configuration (opt-in; server-side only; keys never committed)
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
